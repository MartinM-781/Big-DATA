# Copy to `.env` and adjust if needed.
# Where the IMDb raw/clean data lives. Leave unset to use the Docker named
# volume `imdb-data` (fastest on Windows/macOS). Set to a host path to bind it.
# DATA_DIR=./data

# Contact string sent in the User-Agent of Wikipedia/Wikidata requests
# (Wikimedia policy asks for a way to reach the operator). Put a URL or e-mail.
WIKI_CONTACT=https://github.com/<your-org>/<your-repo>
